# Django核心配置
SECRET_KEY=django-insecure-xxx-your-own-secret-key-xxx  # 用你settings.py里的SECRET_KEY
DEBUG=False  # 容器化后关闭调试模式
ALLOWED_HOSTS=*  # 允许所有域名访问

# PostgreSQL数据库配置
DATABASE_NAME=blogdb
DATABASE_USER=bloguser
DATABASE_PASSWORD=blogpassword
DATABASE_HOST=db  # 对应docker-compose里的数据库服务名
DATABASE_PORT=5432